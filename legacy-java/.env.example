ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-6
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash
REDIS_PASSWORD=kinderuber123
LLM_FALLBACK_ENABLED=true
LLM_TIMEOUT_SECONDS=30
# 使用 UTF-8 字节数做保守 token 估算；输出 token 预算单独保留
LLM_MAX_INPUT_TOKENS=48000
LLM_MAX_BACKGROUND_TOKENS=4000
LLM_MAX_TOOL_RESULT_TOKENS=2000
# 默认使用 Anthropic；切换 DeepSeek 时改成 deepseek。
SPRING_PROFILES_ACTIVE=anthropic

# 生产模式必须配置非空 JSON Token 映射；每个 Token 至少 24 字符。
KINDER_UBER_ENV=development
KINDER_UBER_API_TOKENS=

# 各角色沿用当前 Provider，可覆盖同一适配器的模型名、温度和输出预算。
KINDER_UBER_GENERAL_MODEL=
KINDER_UBER_GENERAL_TEMPERATURE=0.3
KINDER_UBER_GENERAL_MAX_TOKENS=900
KINDER_UBER_TECHNICAL_MODEL=
KINDER_UBER_TECHNICAL_TEMPERATURE=0.1
KINDER_UBER_TECHNICAL_MAX_TOKENS=1200
KINDER_UBER_BILLING_MODEL=
KINDER_UBER_BILLING_TEMPERATURE=0.0
KINDER_UBER_BILLING_MAX_TOKENS=1100
KINDER_UBER_COMPOSER_MODEL=
KINDER_UBER_COMPOSER_TEMPERATURE=0.1
KINDER_UBER_COMPOSER_MAX_TOKENS=1000
KINDER_UBER_COMPOSER_TIMEOUT_S=8

# 意图向量：auto / local / siliconflow；在线模型固定 BAAI/bge-m3。
INTENT_EMBEDDING_PROVIDER=auto
SILICONFLOW_API_KEY=

# 外部 MCP：默认 Microsoft Learn，只读且仅 General / Technical 可用。
MCP_ENABLED=true
# 写工具需同时设置此开关和对应服务器 read_only=false；默认关闭。
MCP_WRITE_ENABLED=false
MCP_SERVERS_CONFIG=config/mcp_servers.json

# 开发环境默认加载示例知识；production 不加载。
KNOWLEDGE_SEED_DEMO=true
KINDER_UBER_DATA_DIR=data/java
MEMORY_TTL_SECONDS=86400
MEMORY_WORKING_MAX=20
MEMORY_COMPRESS_AT=15

# Judge 使用当前聊天 Provider；空模型名表示沿用当前模型。
EVAL_JUDGE_MODEL=
EVAL_JUDGE_MAX_TOKENS=4096
EVAL_JUDGE_TIMEOUT_S=45
EVAL_BASELINE_PATH=data/eval/baseline.json

MONITOR_SUCCESS_RATE_THRESHOLD=0.90
MONITOR_LATENCY_MS_THRESHOLD=3000
ALERT_WEBHOOK_URL=

# RAG 与长期记忆共用真实本地 MiniLM 模型，分开存储三个集合。
# local：开发环境本地持久化；chroma：独立服务；disabled：仅用于离线测试。
# production 必须使用 chroma，不会静默退回本地存储。
SEMANTIC_STORAGE_MODE=local
SEMANTIC_LOCAL_DIR=data/java/vectors
CHROMA_BASE_URL=http://localhost:8002
CHROMA_API_VERSION=V2
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_COLLECTION_PREFIX=kinderuber_java_minilm_v1
KINDER_UBER_MONITOR_FALLBACK_PENALTY=0.5
KINDER_UBER_MONITOR_COOLDOWN_SECONDS=60
